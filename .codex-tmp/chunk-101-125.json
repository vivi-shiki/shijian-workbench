:null,"series":null,"lines":["吟魂易放早春天，","風物江南倍可憐。","底事蘭成能作賦，","感懷偏在戊辰年。"],"prose":"","notes":[],"source_pages":[114],"confidence":0.9,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":2,"total":null},"lines":["春朝歲旦古難并，","十九年來見兩巡。","記得簸錢時未遠，","對門除夕看迎春。"],"prose":"","notes":[],"source_pages":[114],"confidence":0.88,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":3,"total":null},"lines":["舊家姑娣別經年，","歲月圍爐剖橘筵。","侍女却防歡喜炭，","笑花飛上畫裙緣。"],"prose":"","notes":[],"source_pages":[114],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":4,"total":null},"lines":["朋歡婣閥互經過，","背後綾紋刺幾何。","邂逅肩輿不相問，","奚奴私見客名多。"],"prose":"","notes":[],"source_pages":[114,115],"confidence":0.72,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":5,"total":null},"lines":["閑行坊曲看春聯，","暗露嬋娟屈戌邊。","小户豈曾窺邸報，","也隨人寫太平年。"],"prose":"","notes":[{"position":{"field":"lines","line":4,"offset":7},"text":"自注：是歲崇禎元年，新天子更化，朝野欣然有再生之喜。"}],"source_pages":[115],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":6,"total":null},"lines":["蔣侯旌騎出西村，","姊妹同看倚戟門。","笑恨芳香吳望子，","不留冰玉永承恩。"],"prose":"","notes":[],"source_pages":[115,116],"confidence":0.8,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":7,"total":null},"lines":["休甯藥炮舊知名，","俊健游郎滿路擎。","一炷挂香渾未了，","手中拋過百千聲。"],"prose":"","notes":[],"source_pages":[116],"confidence":0.88,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":8,"total":null},"lines":["道北賓筵夕夕張，","也呼朋社一猖狂。","怪來羅列珍羞甚，","人曰曾扳水部郎。"],"prose":"","notes":[],"source_pages":[116],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":9,"total":null},"lines":["莫怪河豚價不廉，","橋南酬過五千錢。","誰知太宰歸田曰，","只與屠沽意氣鮮。"],"prose":"","notes":[{"position":{"field":"lines","line":3,"offset":7},"text":"一作後。"}],"source_pages":[116],"confidence":0.82,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":10,"total":null},"lines":["佛閣前頭照水梅，","半晴天氣暖催開。","嬌憨小妹驚看見，","一日來攀四五回。"],"prose":"","notes":[],"source_pages":[116],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":11,"total":null},"lines":["多少藍衫聚邑門，","提燈捧盒酒盈尊。","須臾看點紅單出，","箇箇僉名有沐恩。"],"prose":"","notes":[],"source_pages":[117],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":12,"total":null},"lines":["盼得燈興趁踏歌，","縣門無榜奈愁何。","可知巷陌蕭條夜，","成就歡期事轉多。"],"prose":"","notes":[{"position":{"field":"lines","line":4,"offset":1},"text":"一作圓。"}],"source_pages":[117],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"新歲竹枝詞","index":13,"total":null},"lines":["筆床硯匣本長閑，","每到新年説掩關。","賓友到門俱謝却，","夜來相遇看鰲山。"],"prose":"","notes":[],"source_pages":[117],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":1,"total":12},"lines":["簾外陰晴幾徧探，","侍兒猶恐意難堪。","雖然殘雪消還有，","且喜今朝尚十三。"],"prose":"","notes":[],"source_pages":[117],"confidence":0.9,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":2,"total":12},"lines":["燈街試走斷紅顰，","新嫁橋南第幾晨。","夫壻卻扶佯不要，","一回低媚一回嗔。"],"prose":"","notes":[{"position":{"field":"lines","line":1,"offset":4},"text":"一作初出。"}],"source_pages":[118],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":3,"total":12},"lines":["青油車子過斜陽，","風颺湘簾出畫裳。","曾在石家筵上見，","是誰香氣試猜詳。"],"prose":"","notes":[{"position":{"field":"lines","line":4,"offset":1},"text":"一作阿。"}],"source_pages":[118],"confidence":0.82,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":4,"total":12},"lines":["步向庭梅遶幾廵，","莫愁家月倍堪珍。","何須更看花燈去，","若箇燈人似箇人。"],"prose":"","notes":[{"position":{"field":"lines","line":4,"offset":4},"text":"自注：京師呼鰲山美人為燈人兒，皆翦綵及通草為之，鮮妍流動如生。"}],"source_pages":[118],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":5,"total":12},"lines":["欲換明粧自忖量，","莫教難認暗衣裳。","忽然省得鍾情句，","不辨花叢却辨香。"],"prose":"","notes":[],"source_pages":[118],"confidence":0.9,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":6,"total":12},"lines":["小玉飛瓊動靜俱，","幾回當面笑愁吁。","眼波第一防他覺，","不審狂郎解得無。"],"prose":"","notes":[{"position":{"field":"lines","line":3,"offset":2},"text":"一作眉梢。"}],"source_pages":[119],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":7,"total":12},"lines":["暗風相約宋牆東，","一寸靈犀兩處同。","南去北來多邂逅，","忽然俱在寺門中。"],"prose":"","notes":[],"source_pages":[119],"confidence":0.9,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":8,"total":12},"lines":["風透珠燈蠟淚流，","隔街簫鼓送人愁。","可憐心似青霄月，","皎潔隨郎處處游。"],"prose":"","notes":[],"source_pages":[119],"confidence":0.9,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":9,"total":12},"lines":["舊曲蔦來不耐聽，","竹棚花火太因仍。","新春小院添春意，","刮骨鹽聲蛤月燈。"],"prose":"","notes":[{"position":{"field":"lines","line":3,"offset":7},"text":"一作新歡新歲多新意。"}],"source_pages":[119],"confidence":0.76,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":10,"total":12},"lines":["為把傾城再拜邀，","一生拚盡在今宵。","自從相見春朝後，","病骨還知剩幾朝。"],"prose":"","notes":[],"source_pages":[119,120],"confidence":0.82,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":11,"total":12},"lines":["尋常聲影限中門，","密笑微香攪夢魂。","此夕試燈兼帖勝，","一時同得到西軒。"],"prose":"","notes":[{"position":{"field":"lines","line":4,"offset":5},"text":"一作在。"}],"source_pages":[120],"confidence":0.86,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"和孝儀看燈詞十二首","index":12,"total":12},"lines":["丹誠默向紫姑陳，","可得心期遂此春。","陵谷滄桑終日事，","不堪長作意中人。"],"prose":"","notes":[],"source_pages":[120],"confidence":0.84,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞","index":1,"total":null},"lines":["繡佛前頭結好因，","上元香火肅凌晨。","懸旛一色燈籠錦，","名氏親書善女人。"],"prose":"","notes":[],"source_pages":[120,121],"confidence":0.82,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞","index":2,"total":null},"lines":["風雨元宵意倍傷，","繡窗低拜掃晴娘。","若教掃得天邊雨，","為掃離人淚兩行。"],"prose":"","notes":[{"position":{"field":"lines","line":2,"offset":2},"text":"一作畫檐。"}],"source_pages":[121],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞","index":3,"total":null},"lines":["腰身十七正嬌慵，","珠鳳鞋帮一捻紅。","不奈小橋春露滑，","阿娘扶過石闌東。"],"prose":"","notes":[],"source_pages":[121],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞","index":4,"total":null},"lines":["瓦坼龜文一例看，","斷橫連竪有悲歡。","一聲脆響籠燈看，","暫作排愁事一端。"],"prose":"","notes":[],"source_pages":[121],"confidence":0.84,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞","index":5,"total":null},"lines":["夜筵花果遶香爐，","心事年年問紫姑。","燈後踏青挑菜起，","不知堪會那人無。"],"prose":"","notes":[{"position":{"field":"lines","line":2,"offset":7},"text":"注見前。"}],"source_pages":[121,122],"confidence":0.78,"boundary_state":"closed","continues_previous":false},{"kind":"poem","title":"","subtitle":"","author":"","form":"七言絕句","heading_level":null,"series":{"title":"又雜題上元竹枝詞"