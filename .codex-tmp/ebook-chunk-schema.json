{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["range", "chunks", "entries", "issues"],
  "properties": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer" },
        "end": { "type": "integer" }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_page", "end_page", "context_start_page", "context_end_page"],
        "properties": {
          "start_page": { "type": "integer" },
          "end_page": { "type": "integer" },
          "context_start_page": { "type": "integer" },
          "context_end_page": { "type": "integer" }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "title", "subtitle", "author", "form", "heading_level",
          "series", "lines", "prose", "notes", "source_pages", "confidence",
          "boundary_state", "continues_previous"
        ],
        "properties": {
          "kind": { "type": "string", "enum": ["heading", "book_text", "biography", "poem", "preface", "note", "colophon", "other"] },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "author": { "type": "string" },
          "form": { "type": "string" },
          "heading_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
          "series": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "index", "total"],
                "properties": {
                  "title": { "type": "string" },
                  "index": { "type": "integer", "minimum": 1 },
                  "total": { "type": ["integer", "null"], "minimum": 1 }
                }
              }
            ]
          },
          "lines": { "type": "array", "items": { "type": "string" } },
          "prose": { "type": "string" },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "text"],
              "properties": {
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "line", "offset"],
                  "properties": {
                    "field": { "type": "string", "enum": ["title", "series", "lines"] },
                    "line": { "type": ["integer", "null"], "minimum": 1 },
                    "offset": { "type": "integer", "minimum": 0 }
                  }
                },
                "text": { "type": "string" }
              }
            }
          },
          "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "boundary_state": { "type": "string", "enum": ["closed", "open"] },
          "continues_previous": { "type": "boolean" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_pages", "description", "candidates"],
        "properties": {
          "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
          "description": { "type": "string" },
          "candidates": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
