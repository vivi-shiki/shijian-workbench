# Node dependencies and build output
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Python environments, bytecode, and tool caches
.venv/
.venv_*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Logs and runtime files
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Source documents are local inputs and can be very large.
/data/input/*
!/data/input/.gitkeep

# Local project data, including images, OCR output, metadata, and edits
/data/projects/
/data/input/

# Downloaded or generated tool bundles
/tools/pdf-render-deps/
/tools/ndlkotenocr-lite/
/remote/*.zip
