{
  "name": "oldbook-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "api": "node server/index.mjs",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test server/*.test.mjs",
    "ebook:punctuate-notes": "node scripts/punctuate_ebook_notes.mjs",
    "ebook:format-prose": "node scripts/format_ebook_prose.mjs",
    "ebook:format-prefaces": "node scripts/format_ebook_prose.mjs",
    "history:bootstrap": "node scripts/history.mjs bootstrap",
    "history:begin": "node scripts/history.mjs begin",
    "history:commit": "node scripts/history.mjs commit",
    "history:show": "node scripts/history.mjs show",
    "preview": "vite preview --host 127.0.0.1",
    "project:build": "python scripts/build_project.py",
    "project:export": "python scripts/export_project.py",
    "volume:prepare": "python scripts/prepare_volume_project.py",
    "volume:ocr": "python -u scripts/run_volume_models.py",
    "volume:validate": "python scripts/validate_volume_project.py",
    "ocr:paddlevl": ".venv_paddlevl\\Scripts\\python.exe scripts/run_paddlevl.py",
    "ocr:openai-vl": "python scripts/run_openai_vl.py",
    "ocr:remote-paddlevl": "python scripts/run_remote_paddlevl.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "vite": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {}
}
