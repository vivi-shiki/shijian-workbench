{
  "name": "oldbook-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:api:dev\" \"npm:web\"",
    "api": "node packages/oldbook-server/src/index.mjs",
    "api:dev": "node --watch --watch-preserve-output packages/oldbook-server/src/index.mjs",
    "web": "vite --config packages/oldbook-review/vite.config.js --host 127.0.0.1",
    "build": "vite build --config packages/oldbook-review/vite.config.js",
    "test": "node --test packages/oldbook-core/test/*.test.mjs packages/oldbook-review/test/*.test.mjs",
    "test:ocr": "python -m unittest discover -s packages/oldbook-cli/test/ocr -v",
    "ebook:generate": "node packages/oldbook-cli/src/ebook.mjs generate",
    "ebook:evaluate": "node packages/oldbook-cli/src/ebook.mjs evaluate",
    "ebook:apply": "node packages/oldbook-cli/src/ebook.mjs apply",
    "history:bootstrap": "node packages/oldbook-cli/src/history.mjs bootstrap",
    "history:begin": "node packages/oldbook-cli/src/history.mjs begin",
    "history:commit": "node packages/oldbook-cli/src/history.mjs commit",
    "history:show": "node packages/oldbook-cli/src/history.mjs show",
    "dataset:freeze": "node packages/oldbook-cli/src/dataset.mjs freeze",
    "dataset:verify": "node packages/oldbook-cli/src/dataset.mjs verify",
    "dataset:list": "node packages/oldbook-cli/src/dataset.mjs list",
    "experiment:prepare": "node packages/oldbook-cli/src/experiment.mjs prepare-ocr-comparison",
    "experiment:archive": "node packages/oldbook-cli/src/experiment.mjs archive-ocr-comparison",
    "experiment:run": "node packages/oldbook-cli/src/experiment.mjs run-ocr-comparison",
    "preview": "vite preview --config packages/oldbook-review/vite.config.js --host 127.0.0.1",
    "project:build": "python packages/oldbook-cli/src/ocr/build_project.py",
    "project:export": "python packages/oldbook-cli/src/ocr/export_project.py",
    "volume:prepare": "python packages/oldbook-cli/src/ocr/prepare_volume_project.py",
    "volume:ocr": "python -u packages/oldbook-cli/src/ocr/run_volume_models.py",
    "volume:validate": "python packages/oldbook-cli/src/ocr/validate_volume_project.py",
    "ocr:paddlevl": ".venv_paddlevl\\Scripts\\python.exe packages/oldbook-cli/src/ocr/run_paddlevl.py",
    "ocr:openai-vl": "python packages/oldbook-cli/src/ocr/run_openai_vl.py",
    "ocr:remote-paddlevl": "python packages/oldbook-cli/src/ocr/run_remote_paddlevl.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "vite": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {}
}
